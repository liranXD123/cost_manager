{
  "name": "cost-manager",
  "version": "1.0.0",
  "description": "Final project - Cost Manager REST API (4 processes)",
  "main": "processes/usersProcess.js",
  "scripts": {
    "start:users": "node processes/usersProcess.js",
    "start:costs": "node processes/costsProcess.js",
    "start:logs": "node processes/logsProcess.js",
    "start:admin": "node processes/adminProcess.js",
    "start": "concurrently -n users,costs,logs,admin \"npm run start:users\" \"npm run start:costs\" \"npm run start:logs\" \"npm run start:admin\"",

    "dev:users": "nodemon processes/usersProcess.js",
    "dev:costs": "nodemon processes/costsProcess.js",
    "dev:logs": "nodemon processes/logsProcess.js",
    "dev:admin": "nodemon processes/adminProcess.js",
    "dev": "concurrently -n users,costs,logs,admin \"npm run dev:users\" \"npm run dev:costs\" \"npm run dev:logs\" \"npm run dev:admin\"",

    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "mongoose": "^8.21.0",
    "mongoose-double": "^0.0.1",
    "pino": "^8.21.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "supertest": "^6.3.3"
  }
}
